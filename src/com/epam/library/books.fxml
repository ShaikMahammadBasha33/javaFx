<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400" prefWidth="600" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.epam.library.BooksController">

	<children>
		<TableView fx:id="booksTable" layoutX="20" layoutY="20" prefHeight="200" prefWidth="560">
			<columns>
				<TableColumn fx:id="titleColumn" prefWidth="200" text="Title" />
				<TableColumn fx:id="authorColumn" prefWidth="200" text="Author" />
				<TableColumn fx:id="availableColumn" prefWidth="150" text="Available" />
			</columns>
		</TableView>

		<Label layoutX="20" layoutY="240" text="Title:" />
		<TextField fx:id="titleField" layoutX="70" layoutY="235" prefWidth="200" />
		<Label layoutX="290" layoutY="240" text="Author:" />
		<TextField fx:id="authorField" layoutX="350" layoutY="235" prefWidth="200" />

		<Button layoutX="70" layoutY="280" onAction="#addBook" text="Add Book" />
		<Button layoutX="170" layoutY="280" onAction="#deleteBook" text="Delete Book" />
		<Button layoutX="391.0" layoutY="280.0" onAction="#saveBooks" prefWidth="100" text="Save Books" />
		<Button layoutX="270.0" layoutY="280.0" onAction="#loadBooks" prefWidth="100" text="Load Books" />
	</children>
</AnchorPane>
