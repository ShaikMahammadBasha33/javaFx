<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400" prefWidth="600" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.epam.library.PersonsController">

    <children>
        <TableView fx:id="personsTable" layoutX="20" layoutY="20" prefHeight="200" prefWidth="560">
            <columns>
                <TableColumn fx:id="nameColumn" prefWidth="250" text="Name" />
                <TableColumn fx:id="emailColumn" prefWidth="300" text="Email" />
            </columns>
        </TableView>

        <Label layoutX="20" layoutY="240" text="Name:" />
        <TextField fx:id="nameField" layoutX="70" layoutY="235" prefWidth="200" />
        <Label layoutX="290" layoutY="240" text="Email:" />
        <TextField fx:id="emailField" layoutX="340" layoutY="235" prefWidth="200" />

        <Button layoutX="70" layoutY="280" onAction="#addPerson" text="Add Person" />
        <Button layoutX="170" layoutY="280" onAction="#deletePerson" text="Delete Person" />
          <Button layoutX="419.0" layoutY="280.0" onAction="#savePersons" prefWidth="100" text="Save Persons" />
    <Button layoutX="290.0" layoutY="280.0" onAction="#loadPersons" prefWidth="100" text="Load Persons" />
    </children>
</AnchorPane>
