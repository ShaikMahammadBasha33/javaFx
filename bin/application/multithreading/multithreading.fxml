<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="application.multithreading.MultiThreadController"
            prefWidth="400" prefHeight="250">

    <children>
        <Label fx:id="statusLabel" layoutX="50" layoutY="30" text="Click start to run task!" />

        <ProgressBar fx:id="progressBar" layoutX="50" layoutY="70"
                     prefWidth="300" progress="0.0"/>

        <Button fx:id="startButton" layoutX="50" layoutY="120"
                text="Start Task" onAction="#startTask"/>
    </children>
</AnchorPane>
